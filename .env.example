# ---- Backend ----
# psycopg3 driver: the same URL works for both the async app engine and sync Alembic
DATABASE_URL=postgresql+psycopg://veridoc:veridoc@db:5432/veridoc
REDIS_URL=redis://redis:6379/0
ENV=development
CORS_ORIGINS=http://localhost:5173

# ---- Postgres container ----
POSTGRES_USER=veridoc
POSTGRES_PASSWORD=veridoc
POSTGRES_DB=veridoc

# ---- ML (unused until Phases 2-3) ----
FORENSICS_MODEL_PATH=./ml/checkpoints/forensics_cnn.pt
FACE_MATCH_THRESHOLD=0.55
LIVENESS_THRESHOLD=0.5

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000
